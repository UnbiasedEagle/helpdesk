DATABASE_URL="postgresql://user:password@localhost:5432/helpdesk_dev?schema=public"

PORT=4000

# Better Auth. Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET="change-me-to-a-random-32-plus-char-string"
BETTER_AUTH_URL="http://localhost:4000"
CLIENT_ORIGIN="http://localhost:5173"

# Initial admin account created by `npx prisma db seed`
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="change-me-please"
SEED_ADMIN_NAME="Admin"
